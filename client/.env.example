# Code d'accès du panneau d'administration (/admin).
# Mode invité intégral : aucun compte n'existe, ce code est la seule porte d'entrée admin.
VITE_ADMIN_PASSCODE=Chartrons2026

# Optionnel : URL du backend concierge IA.
# Absent (GitHub Pages), le moteur local de l'annuaire répond à la place.
# VITE_CONCIERGE_API_URL=https://mon-api.example.com/api/concierge

# Staging / site de démo : inclure les commerces simulés (`isDemo: true`) dans
# l'annuaire et le concierge IA. En production, laisser commenté ou `false`.
# VITE_INCLUDE_DEMO_DATA=true
