# Concierge IA — clé serveur uniquement, jamais exposée au navigateur.
# Sans cette clé, /api/concierge répond avec le moteur local (annuaire du quartier).
OPENAI_API_KEY=

# Modèle utilisé par le concierge (défaut : gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# Optionnel : proxy ou déploiement Azure OpenAI compatible /chat/completions.
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Port de l'API Express (défaut : 3001).
# PORT=3001
